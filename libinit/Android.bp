// 1. The Device-Specific Data Library
cc_library_static {
    name: "libvariant_xiaomi_alioth",
    srcs: ["libvariant_xiaomi_alioth.cpp"],
    header_libs: ["libvariant_headers"],
    recovery_available: true,
}

// 2. The Main Common Init Library
cc_library_static {
    name: "init_xiaomi_kona",
    srcs: [
        "init_xiaomi_kona.cpp",
        "libinit_dalvik_heap.cpp",
        "libinit_variant.cpp",
        "libinit_utils.cpp",
    ],
    header_libs: ["libvariant_headers"],
    include_dirs: ["system/core/init"],
    recovery_available: true,
    whole_static_libs: [
        "libbase",
        // Since i only have Alioth, i can hardcode it here
        "libvariant_xiaomi_alioth", 
    ],
}
